# Names only — never commit real values (CLAUDE.md).
# Leave everything blank to run in local mode: SQLite + a stub token verifier.

# Postgres (Supabase: Project settings -> Database -> Connection string)
DATABASE_URL=

# Supabase project, for verifying the app's JWTs
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server-only. Never ships in the app bundle.
SUPABASE_SERVICE_KEY=

# Signed download URLs for goals/<id>.json
SUPABASE_STORAGE_BUCKET=library

# Server-only
YOUTUBE_API_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

ENVIRONMENT=local

# Parental-consent codes go out by email over SMTP. Gmail with an app password
# (smtp.gmail.com:587) or Brevo's free tier both work. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Must be false in production (the server refuses to start otherwise).
OTP_ECHO=true

# Firebase Cloud Messaging (push). Server-only.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated emails allowed into the admin panel. Empty = nobody.
ADMIN_EMAILS=
