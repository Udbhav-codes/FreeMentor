# Names only — never commit real values (CLAUDE.md).
# Leave everything blank to run in local mode: SQLite + a stub token verifier.

# Postgres (Supabase: Project settings -> Database -> Connection string)
DATABASE_URL=

# Supabase project, for verifying the app's JWTs
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server-only. Never ships in the app bundle.
SUPABASE_SERVICE_KEY=

# Signed download URLs for goals/<id>.json
SUPABASE_STORAGE_BUCKET=library

# Server-only
YOUTUBE_API_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

ENVIRONMENT=local
